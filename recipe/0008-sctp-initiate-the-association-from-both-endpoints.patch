     @asynctest
     async def test_bad_cookie(self) -> None:
@@ -1350,6 +1401,7 @@ class RTCSctpTransportTest(TestCase):
                 return await real_send_chunk(chunk)
 
             client._send_chunk = mock_send_chunk  # type: ignore
