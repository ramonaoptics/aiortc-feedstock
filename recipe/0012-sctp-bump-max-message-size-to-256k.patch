From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Philipp Hancke <philipp.hancke@googlemail.com>
Date: Sat, 19 Sep 2026 16:42:12 +0200
Subject: [PATCH 12/21] sctp: bump max-message-size to 256k

because things have progressed a bit since the mess described in
  https://lgrahl.de/articles/demystifying-webrtc-dc-size-limit.html
This matches the default Chrome and Firefox use these days.
64kb is still used as default remote MMS if none is announced.

Throw an error when attempting to send something larger than the
MMS announced by the remote.

Note: the inbound MMS is not (yet) enforced
---
 src/aiortc/rtcsctptransport.py | 26 ++++++++++++-
 tests/test_rtcsctptransport.py | 71 ++++++++++++++++++++++++++++++++++
 2 files changed, 95 insertions(+), 2 deletions(-)

diff --git a/src/aiortc/rtcsctptransport.py b/src/aiortc/rtcsctptransport.py
index 0da9560..6186895 100644
--- a/src/aiortc/rtcsctptransport.py
+++ b/src/aiortc/rtcsctptransport.py
@@ -44,6 +44,13 @@ USERDATA_MAX_LENGTH = (
     * 4
 )
 
+# The maximum message size we advertise in our SDP.
+LOCAL_MAX_MESSAGE_SIZE = 262144
+
+# The maximum message size to assume if the remote party does not
+# advertise one, see RFC 8841 - section 6.
+REMOTE_DEFAULT_MAX_MESSAGE_SIZE = 65536
+
 # protocol constants
 SCTP_CAUSE_INVALID_STREAM = 0x0001
 SCTP_CAUSE_STALE_COOKIE = 0x0003
@@ -652,6 +659,7 @@ class RTCSctpTransport(AsyncIOEventEmitter):
         self._local_verification_tag = random32()
 
         self._remote_extensions: list[int] = []
+        self._remote_max_message_size = REMOTE_DEFAULT_MAX_MESSAGE_SIZE
         self._remote_partial_reliability = False
         self._remote_port: Optional[int] = None
         self._remote_verification_tag = 0
@@ -752,12 +760,14 @@ class RTCSctpTransport(AsyncIOEventEmitter):
 
         :rtype: RTCSctpCapabilities
         """
-        return RTCSctpCapabilities(maxMessageSize=65536)
+        return RTCSctpCapabilities(maxMessageSize=LOCAL_MAX_MESSAGE_SIZE)
 
     def setTransport(self, transport: RTCDtlsTransport) -> None:
         self.__transport = transport
 
-    async def start(self, remoteCaps: RTCSctpCapabilities, remotePort: int) -> None:
+    async def start(
+        self, remoteCaps: Optional[RTCSctpCapabilities], remotePort: int
+    ) -> None:
         """
         Start the transport.
         """
@@ -765,6 +775,8 @@ class RTCSctpTransport(AsyncIOEventEmitter):
             self.__started = True
             self.__state = "connecting"
             self._remote_port = remotePort
+            if remoteCaps is not None:
+                self._remote_max_message_size = remoteCaps.maxMessageSize
 
             # configure logging
             if logger.isEnabledFor(logging.DEBUG):
@@ -1848,6 +1860,16 @@ class RTCSctpTransport(AsyncIOEventEmitter):
         else:
             pp_id, user_data = WEBRTC_BINARY, data
 
+        # A maximum message size of 0 means the remote party can handle
+        # messages of any size.
+        if self._remote_max_message_size and (
+            len(user_data) > self._remote_max_message_size
+        ):
+            raise ValueError(
+                f"Cannot send message of {len(user_data)} bytes, the remote party "
+                f"only supports messages up to {self._remote_max_message_size} bytes"
+            )
+
         channel._addBufferedAmount(len(user_data))
         self._data_channel_queue.append((channel, pp_id, user_data))
         asyncio.ensure_future(self._data_channel_flush())
diff --git a/tests/test_rtcsctptransport.py b/tests/test_rtcsctptransport.py
index 6082382..e5b6fea 100644
--- a/tests/test_rtcsctptransport.py
+++ b/tests/test_rtcsctptransport.py
@@ -8,6 +8,8 @@ from unittest.mock import MagicMock, patch
 from aiortc.exceptions import InvalidStateError
 from aiortc.rtcdatachannel import RTCDataChannel, RTCDataChannelParameters
 from aiortc.rtcsctptransport import (
+    LOCAL_MAX_MESSAGE_SIZE,
+    REMOTE_DEFAULT_MAX_MESSAGE_SIZE,
     SCTP_DATA_FIRST_FRAG,
     SCTP_DATA_LAST_FRAG,
     SCTP_DATA_UNORDERED,
@@ -917,6 +919,75 @@ class RTCSctpTransportTest(TestCase):
             self.assertEqual(server_channels[0].id, 0)
             self.assertEqual(server_channels[0].label, "chat")
 
+    @asynctest
+    async def test_connect_then_send_message_too_large(self) -> None:
+        async with client_and_server() as (client, server):
+            # connect, the server only accepts messages of up to 1000 bytes
+            await server.start(client.getCapabilities(), client.port)
+            await client.start(RTCSctpCapabilities(maxMessageSize=1000), server.port)
+
+            # check outcome
+            await wait_for_outcome(client, server)
+            self.assertEqual(
+                client._association_state, RTCSctpTransport.State.ESTABLISHED
+            )
+
+            # create data channel
+            channel = RTCDataChannel(client, RTCDataChannelParameters(label="chat"))
+            await asyncio.sleep(0.1)
+            self.assertEqual(channel.readyState, "open")
+
+            # a message which fits is accepted
+            channel.send(b"M" * 1000)
+
+            # a larger message is rejected and is not buffered
+            buffered_amount = channel.bufferedAmount
+            with self.assertRaises(ValueError) as cm:
+                channel.send(b"M" * 1001)
+            self.assertEqual(
+                str(cm.exception),
+                "Cannot send message of 1001 bytes, the remote party only supports "
+                "messages up to 1000 bytes",
+            )
+            self.assertEqual(channel.bufferedAmount, buffered_amount)
+
+    @asynctest
+    async def test_connect_then_send_message_unlimited(self) -> None:
+        async with client_and_server() as (client, server):
+            # connect, the server accepts messages of any size
+            await server.start(client.getCapabilities(), client.port)
+            await client.start(RTCSctpCapabilities(maxMessageSize=0), server.port)
+
+            # check outcome
+            await wait_for_outcome(client, server)
+            self.assertEqual(
+                client._association_state, RTCSctpTransport.State.ESTABLISHED
+            )
+
+            # create data channel
+            channel = RTCDataChannel(client, RTCDataChannelParameters(label="chat"))
+            await asyncio.sleep(0.1)
+            self.assertEqual(channel.readyState, "open")
+
+            # a large message is accepted
+            channel.send(b"M" * (2 * LOCAL_MAX_MESSAGE_SIZE))
+
+    @asynctest
+    async def test_connect_without_remote_capabilities(self) -> None:
+        async with client_and_server() as (client, server):
+            # connect, the server did not advertise a maximum message size
+            await server.start(client.getCapabilities(), client.port)
+            await client.start(None, server.port)
+
+            # check outcome
+            await wait_for_outcome(client, server)
+            self.assertEqual(
+                client._association_state, RTCSctpTransport.State.ESTABLISHED
+            )
+            self.assertEqual(
+                client._remote_max_message_size, REMOTE_DEFAULT_MAX_MESSAGE_SIZE
+            )
+
