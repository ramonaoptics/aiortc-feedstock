From d0886393304c25d3e4b608e3b914ff6f30e2bf3d Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Tue, 9 Dec 2025 08:15:59 -0500
Subject: [PATCH 3/4] Disable automatic bandwidth adjustment and expose encoder
 as property

---
 src/aiortc/rtcrtpsender.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/aiortc/rtcrtpsender.py b/src/aiortc/rtcrtpsender.py
index 475547e..102865e 100644
--- a/src/aiortc/rtcrtpsender.py
+++ b/src/aiortc/rtcrtpsender.py
@@ -139,6 +139,10 @@ class RTCRtpSender:
     def kind(self) -> str:
         return self.__kind
 
+    @property
+    def encoder(self):
+        return self.__encoder
+
     @property
     def track(self) -> MediaStreamTrack:
         """
@@ -286,8 +290,8 @@ class RTCRtpSender:
                     self.__log_debug(
                         "- receiver estimated maximum bitrate %d bps", bitrate
                     )
-                    if self.__encoder and hasattr(self.__encoder, "target_bitrate"):
-                        self.__encoder.target_bitrate = bitrate
+                    # if self.__encoder and hasattr(self.__encoder, "target_bitrate"):
+                    #     self.__encoder.target_bitrate = bitrate
             except ValueError:
                 pass
 
